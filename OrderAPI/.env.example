# ── Banco de Dados (obrigatório) ──────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# ── Servidor ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Autenticação JWT (obrigatório) ────────────────────────────
JWT_SECRET="gere-um-segredo-forte-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="1d"

# ── Seed: Credenciais do Admin (usado apenas no npm run seed) ─
ADMIN_EMAIL="admin@seurestaurante.com"
ADMIN_PASSWORD="SuaSenhaForte123!"

# ── Configurações padrão do restaurante (usadas no seed) ──────
DEFAULT_TOTAL_MESAS=70
DEFAULT_DURACAO_RESERVA_MINUTOS=120
DEFAULT_DURACAO_LIMPEZA_MINUTOS=15
DEFAULT_API_PIN="seu-pin-seguro"

# ── CORS e Rate Limit ─────────────────────────────────────────
CORS_ORIGIN="*"
RATE_LIMIT=300
